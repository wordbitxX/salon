# ---------------------------------------------------------------------------
# Database — Supabase, Neon, RDS or any Postgres.
# Supabase: Project → Settings → Database → Connection string → URI
# (use the pooler "Connection pooling" URI on Vercel / serverless hosts)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ---------------------------------------------------------------------------
# First owner login. Created automatically the first time the dashboard opens.
# Change these before handing the salon the dashboard (or change the password
# later from Dashboard → My account).
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@elanbeauty.pk"
ADMIN_PASSWORD="Elan@2026"

# Optional demo logins (manager + receptionist) created on first launch.
# SEED_DEMO_TEAM="false"
# Hide the demo credentials card on the sign-in screen:
# SHOW_DEMO_LOGINS="false"

# Canonical site URL used for SEO metadata / sitemap
# NEXT_PUBLIC_SITE_URL="https://your-salon.vercel.app"
